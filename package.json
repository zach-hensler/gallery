{
  "name": "Gallery",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://gallery.zach-hensler.com",
  "scripts": {
    "dev": "vite",
    "upgrade": "npx npm-check-updates -u",
    "test": "vitest --run",
    "createCNAME": "echo gallery.zach-hensler.com > ./build/CNAME",
    "build": "tsc && vite build && npm run createCNAME",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "gh-pages": "^6.3.0",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
